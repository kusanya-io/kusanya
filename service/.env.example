# Inject real credentials locally; never commit them. URL query parameters are rejected.
DATABASE_URL=postgresql://kusanya@localhost:5432/kusanya
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=3000
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Deployment default, not tenant identity. Empty until namespace linking is verified.
# When configured, supply the namespace followed by two underscores.
SALESFORCE_NAMESPACE_PREFIX=
# Tenant credential keys stay in the deployment secret store, never PostgreSQL.
# Each value is a unique key id, a colon and one canonical base64 32-byte key.
TENANT_CREDENTIAL_ACTIVE_KEY_ID=local-v1
TENANT_CREDENTIAL_KEYS=local-v1:REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
# Mounted administrator publication surface (ADR 0050).
ADMIN_EXTERNAL_ORIGIN=https://kusanya.example
ADMIN_OIDC_ISSUER=https://login.microsoftonline.com/REPLACE_TENANT_ID/v2.0
ADMIN_OIDC_AUDIENCE=REPLACE_KUSANYA_API_CLIENT_ID
ADMIN_OIDC_JWKS_URI=https://login.microsoftonline.com/REPLACE_TENANT_ID/discovery/v2.0/keys
ADMIN_SESSION_SECRET=REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
ADMIN_SESSION_TTL_SECONDS=28800
ADMIN_INVITATION_TTL_SECONDS=86400
SALESFORCE_OAUTH_CLIENT_ID=REPLACE_WITH_CONNECTED_APP_CLIENT_ID
SALESFORCE_OAUTH_CLIENT_SECRET=REPLACE_WITH_CONNECTED_APP_CLIENT_SECRET
# A separate canonical base64 32-byte deployment secret derives PKCE and browser binding.
SALESFORCE_OAUTH_STATE_SECRET=REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
SALESFORCE_OAUTH_TIMEOUT_MS=10000
SALESFORCE_OAUTH_TRANSACTION_TTL_SECONDS=300
SALESFORCE_REFRESH_TIMEOUT_MS=10000
SALESFORCE_REQUEST_TIMEOUT_MS=10000
SALESFORCE_PUBLICATION_TIMEOUT_MS=120000
# These absolute paths must identify the reviewed Java runtime and pinned jar.
ODK_VALIDATE_JAVA_EXECUTABLE=/usr/bin/java
ODK_VALIDATE_JAR_PATH=/opt/kusanya/ODK-Validate-v1.20.0.jar
