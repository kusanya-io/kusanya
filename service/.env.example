# Inject real credentials locally; never commit them. URL query parameters are rejected.
DATABASE_URL=postgresql://kusanya@localhost:5432/kusanya
DATABASE_SSL=true
DATABASE_POOL_MAX=10
DATABASE_TIMEOUT_MS=3000
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
# Deployment default, not tenant identity. Empty until namespace linking is verified.
# When configured, supply the namespace followed by two underscores.
SALESFORCE_NAMESPACE_PREFIX=
# Tenant credential keys stay in the deployment secret store, never PostgreSQL.
# Each value is a unique key id, a colon and one canonical base64 32-byte key.
TENANT_CREDENTIAL_ACTIVE_KEY_ID=local-v1
TENANT_CREDENTIAL_KEYS=local-v1:REPLACE_WITH_CANONICAL_BASE64_32_BYTE_KEY
