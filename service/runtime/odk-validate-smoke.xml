<?xml version="1.0" encoding="UTF-8"?>
<h:html
  xmlns="http://www.w3.org/2002/xforms"
  xmlns:h="http://www.w3.org/1999/xhtml"
  xmlns:jr="http://openrosa.org/javarosa"
>
  <h:head>
    <h:title>Kusanya validator smoke</h:title>
    <model>
      <instance>
        <data id="kusanya-validator-smoke" version="1">
          <answer />
          <meta>
            <instanceID />
          </meta>
        </data>
      </instance>
      <bind nodeset="/data/answer" type="string" />
      <bind
        calculate="concat('uuid:', uuid())"
        nodeset="/data/meta/instanceID"
        readonly="true()"
        type="string"
      />
    </model>
  </h:head>
  <h:body>
    <input ref="/data/answer">
      <label>Smoke</label>
    </input>
  </h:body>
</h:html>
